<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Update this to your Bannerlord 1.4.5 + War Sails install for easy references -->
    <GameFolder Condition="'$(GameFolder)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Mount &amp; Blade II Bannerlord</GameFolder>
    <GameBinWin64>$(GameFolder)\bin\Win64_Shipping_Client</GameBinWin64>

    <!-- Recommended: Set this when building for a specific game version -->
    <!-- <GameVersion>1.4.5</GameVersion> -->

    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>

    <!-- Mod identity -->
    <AssemblyName>TroopManagerEnhanced</AssemblyName>
    <RootNamespace>TroopManagerEnhanced</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>YourName</Authors>
    <Product>TroopManagerEnhanced</Product>
    <Description>Automated troop upgrade, recruit, and management for Bannerlord player parties. MCM configurable.</Description>

    <!-- Output: we copy via PostBuild to the _Module structure -->
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <!-- Recommended for Bannerlord mods -->
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- Game assembly references (Private = false so they are not copied to output) -->
  <ItemGroup>
    <!-- Primary game assemblies - adjust if your game version differs slightly in naming -->
    <Reference Include="TaleWorlds.CampaignSystem">
      <HintPath>$(GameBinWin64)\TaleWorlds.CampaignSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Core">
      <HintPath>$(GameBinWin64)\TaleWorlds.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Library">
      <HintPath>$(GameBinWin64)\TaleWorlds.Library.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.Localization">
      <HintPath>$(GameBinWin64)\TaleWorlds.Localization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.MountAndBlade">
      <HintPath>$(GameBinWin64)\TaleWorlds.MountAndBlade.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.ObjectSystem">
      <HintPath>$(GameBinWin64)\TaleWorlds.ObjectSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaleWorlds.SaveSystem">
      <HintPath>$(GameBinWin64)\TaleWorlds.SaveSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Add more as needed (SandBox, StoryMode, etc.) -->
  </ItemGroup>

  <!-- Bannerlord community framework packages -->
  <ItemGroup>
    <!-- MCM v5+ - IncludeAssets="compile" is critical -->
    <PackageReference Include="Bannerlord.MCM" Version="5.11.3" IncludeAssets="compile" />

    <!-- Optional: If you want ButterLib services / helpers directly -->
    <!-- <PackageReference Include="Bannerlord.ButterLib" Version="2.8.0" IncludeAssets="compile" /> -->

    <!-- Harmony is provided at runtime by Bannerlord.Harmony module.
         For compile-time you can reference Lib.Harmony if needed for advanced usage.
         Most people do NOT ship 0Harmony.dll themselves anymore. -->
    <!-- <PackageReference Include="Lib.Harmony" Version="2.3.3" /> -->
  </ItemGroup>

  <!-- Post-build: Copy the built DLL + pdb into the deployable _Module structure -->
  <Target Name="CopyToModule" AfterTargets="Build">
    <ItemGroup>
      <ModOutputFiles Include="$(OutputPath)$(AssemblyName).dll" />
      <ModOutputFiles Include="$(OutputPath)$(AssemblyName).pdb" Condition="Exists('$(OutputPath)$(AssemblyName).pdb')" />
    </ItemGroup>

    <Copy SourceFiles="@(ModOutputFiles)"
          DestinationFolder="$(_ModulePath)bin\Win64_Shipping_Client"
          SkipUnchangedFiles="true" />

    <Message Text="TroopManagerEnhanced: Copied build output to _Module/bin/Win64_Shipping_Client" Importance="high" />
  </Target>

  <!-- Convenience: define _ModulePath relative to project -->
  <PropertyGroup>
    <_ModulePath>$(MSBuildProjectDirectory)\_Module\</_ModulePath>
  </PropertyGroup>

  <!-- Optional: Strong naming / signing not usually needed for Bannerlord mods -->
</Project>
